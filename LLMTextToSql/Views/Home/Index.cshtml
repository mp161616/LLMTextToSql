@{
    ViewData["Title"] = "Text to SQL";
}

<h2>Text to SQL</h2>

<form method="post">
    <input type="text" name="inputValue" class="form-control" placeholder="Ask a question..." />
    <button type="submit" class="btn btn-primary mt-2">CONVERT TO SQL</button>
</form>

@if (ViewBag.Result != null)
{
    <div class="alert alert-info mt-3">
        <strong>Generated SQL:</strong>
        <pre>@ViewBag.Result</pre>
    </div>
}

